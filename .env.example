# Copy this file's values into your own env files. Never commit the real ones.
# docker compose reads two files: backend/.env and frontend/.env.

# ---- backend/.env ----
DB_HOST=database
DB_PORT=5432
DB_USERNAME=irent_user
DB_PASSWORD=change_me
DB_NAME=irent
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=irent
POSTGRES_USER=irent_user
POSTGRES_PASSWORD=change_me

# email sent at sign up (use an app password, not your real password)
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_app_password

# password of the demo owners of the sample listings (optional;
# without it their password is random and nobody can sign in with them)
DEMO_OWNER_PASSWORD=choose_a_demo_password

# ---- frontend/.env ----
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_MAP_ID=your_google_maps_vector_map_id

# ---- monitoring (the .env file docker compose reads, next to docker-compose.yml) ----
# sign-in for the Grafana dashboards at http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password
